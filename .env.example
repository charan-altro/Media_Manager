# Copy this file and rename to .env, then fill in your API keys
# The Rust server loads this automatically on startup via dotenvy

DATABASE_URL=sqlite:mediavault.db

# Get your API key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Optional - OMDb for IMDb ratings. Get from https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here

# Optional extras
FANART_API_KEY=
TRAKT_API_KEY=
TVDB_API_KEY=
MOVIEMETER_API_KEY=
SPORTSDB_API_KEY=
KYRADB_API_KEY=
OPENSUBTITLES_API_KEY=

